<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <add name="MyLibrary.Properties.Settings.MyLibrary1ConnectionString"
			 providerName="System.Data.OleDb"
             connectionString="Provider=Microsoft.ACE.OLEDB.16.0;Data Source=|DataDirectory|\MyLibrary1.accdb;Persist Security Info=False;" />
	</connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>